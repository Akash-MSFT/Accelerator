# ============================================================================
# Dockerfile.reuse — MACAE backend for the RPSI private landing zone.
# Same as Dockerfile.NoCache but adds entrypoint.sh which patches /etc/hosts
# from the EXTRA_HOSTS env var (private-DNS workaround) before launching uvicorn.
#
# Build:
#   az acr build --registry acrdigitalmfgrpsidweu01 \
#     --image macae-backend:reuse-1 \
#     --file src/backend/Dockerfile.reuse src/backend
# ============================================================================

# Base Python image
FROM python:3.11-slim-bullseye AS base
WORKDIR /app

FROM base AS builder
COPY --from=ghcr.io/astral-sh/uv:0.6.3 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

WORKDIR /app
COPY uv.lock pyproject.toml /app/

RUN uv sync --frozen --no-install-project --no-dev

# Backend app setup
COPY . /app
RUN uv sync --frozen --no-dev


FROM base

COPY --from=builder /app /app
COPY --from=builder /bin/uv /bin/uv

ENV PATH="/app/.venv/bin:$PATH"

# Private-DNS /etc/hosts workaround entrypoint
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["uv", "run", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
